# Copy this file to .env and fill in your API keys

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (GPT-4o, o3, etc.)
OPENAI_API_KEY=your_openai_api_key_here

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Azure OpenAI
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=your_deployment_name_here

# Default provider: anthropic | openai | azure | gemini
DEFAULT_PROVIDER=openai

# Agent provider: deepseek | codex | openai
AGENT_PROVIDER=deepseek
# Compatibility alias used by CVScreeningAgent/ScreeningPipeline
SCREENING_MODEL_PROVIDER=deepseek

# DeepSeek agent mode
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_THINKING=disabled

# Codex agent mode
# Auth is read from %USERPROFILE%\.codex\auth.json after `codex login`.
CODEX_MODEL=gpt-5.4
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_HOME=
CODEX_COMPACTION_MODEL=
CODEX_MAX_RETRIES=8
CODEX_RETRY_SLEEP=3.5

# Generic OpenAI-compatible agent mode
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
COMPACTION_MODEL=
AGENT_TEMPERATURE=0.2
